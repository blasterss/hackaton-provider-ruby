<%
  create_operation = service_view.operation(:create_request)
  success_mappings = create_operation.responses
                                     .select { |response| response.kind == :success }
                                     .flat_map(&:field_mappings)
                                     .uniq { |mapping| mapping.target_path }
  success_statuses = create_operation.responses
                                     .select { |response| response.kind == :success }
                                     .map { |response| response.http_status.to_i }
  duplicate_statuses = create_operation.responses
                                       .select { |response| response.kind == :duplicate }
                                       .map { |response| response.http_status.to_i }
-%>
    def parse_create_response(operation, response)
      case response.status.to_i
<% if success_statuses.any? -%>
      when <%= success_statuses.join(", ") %>
<% success_mappings.each do |mapping| -%>
        <%= service_view.response_assignment(mapping) %>
<% end -%>
        operation
<% end -%>
<% if duplicate_statuses.any? -%>
      when <%= duplicate_statuses.join(", ") %>
        response
<% end -%>
      else
        handle_error_response(response)
      end
    end
